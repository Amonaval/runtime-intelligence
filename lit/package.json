{
  "name": "lit-debug-suite",
  "version": "1.0.0",
  "description": "Runtime intelligence and diagnostics foundation with framework adapters for Lit and React.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./panel": {
      "import": "./src/panel/LdsDebugPanel.js"
    },
    "./adapter/react": {
      "import": "./src/adapter/react/ReactAdapter.js"
    },
    "./custom/ui-platform": {
      "import": "./custom/ui-platform/index.js"
    }
  },
  "scripts": {
    "build:extension": "rollup -c rollup.extension.config.js",
    "build:extension:prod": "NODE_ENV=production rollup -c rollup.extension.config.js",
    "build:lib": "rollup -c rollup.lib.config.js",
    "build": "npm run build:lib && npm run build:extension:prod",
    "serve": "npx serve . -p 8080",
    "test": "node --test test/unit/*.test.mjs"
  },
  "keywords": [
    "runtime-intelligence",
    "diagnostics",
    "lit",
    "react",
    "performance",
    "web-components",
    "devtools"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lit": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  }
}
