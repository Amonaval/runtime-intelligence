{
  "name": "runtime-intelligence",
  "version": "0.1.3",
  "description": "Framework-neutral runtime intelligence with React, Lit, Vue and one canonical mature panel.",
  "private": true,
  "type": "module",
  "exports": {
    "./loader": { "types": "./lit/src/loader/index.d.ts", "import": "./lit/src/loader/index.js" },
    "./loader/vue": { "import": "./lit/src/loader/vue.js" },
    "./core": { "import": "./lit/src/core/index.js" },
    "./extension": { "types": "./lit/src/extension/index.d.ts", "import": "./lit/src/extension/index.js" },
    "./react": { "types": "./lit/src/react/index.d.ts", "import": "./lit/src/react/index.js" },
    "./lit": { "import": "./lit/src/lit/index.js" },
    "./vue": { "types": "./lit/src/vue/index.d.ts", "import": "./lit/src/vue/index.js" },
    "./panel": { "types": "./lit/src/panel/index.d.ts", "import": "./lit/src/panel/index.js" },
    "./panel/lit": "./lit/src/panel/LdsDebugPanel.js",
    "./package.json": "./package.json"
  },
  "files": ["lit/src"],
  "scripts": {
    "test": "npm --prefix lit test",
    "test:smoke": "npm --prefix lit run test:smoke",
    "build": "npm --prefix lit run build",
    "package:validate": "node scripts/validate-package-contract.mjs",
    "api:validate": "node scripts/validate-public-api.mjs",
    "distribution:validate": "node scripts/validate-distribution-policy.mjs",
    "production:validate": "node --test lit/test/unit/production-safety.test.mjs lit/test/unit/browser-runtime-surface.test.mjs lit/test/unit/lit-public-activation.test.mjs",
    "onboarding:validate": "node scripts/validate-onboarding.mjs",
    "validate:release": "npm run package:validate && npm run api:validate && npm run distribution:validate && npm run production:validate && npm run onboarding:validate && npm test",
    "lab:react:install": "npm --prefix examples/react-fault-lab install",
    "lab:react": "npm --prefix examples/react-fault-lab run dev",
    "lab:react:build": "npm --prefix examples/react-fault-lab run build",
    "lab:react:hostile:install": "npm --prefix examples/react-uninstrumented-lab install",
    "lab:react:hostile": "npm --prefix examples/react-uninstrumented-lab run dev",
    "lab:react:hostile:build": "npm --prefix examples/react-uninstrumented-lab run build",
    "lab:react:hostile:validate": "npm --prefix examples/react-uninstrumented-lab run validate:uninstrumented",
    "lab:react:hostile:accept": "npm --prefix examples/react-uninstrumented-lab run accept:browser",
    "lab:vue:install": "npm --prefix examples/vue-fault-lab install",
    "lab:vue": "npm --prefix examples/vue-fault-lab run dev",
    "lab:vue:build": "npm --prefix examples/vue-fault-lab run build",
    "compatibility:validate": "node scripts/validate-r8-compatibility.mjs",
    "overhead:validate": "node scripts/validate-r8-overhead.mjs"
  },
  "dependencies": { "lit": "^3.3.1" },
  "peerDependencies": { "react": ">=18.0.0", "vue": ">=3.3.0" },
  "peerDependenciesMeta": { "react": { "optional": true }, "vue": { "optional": true } },
  "license": "UNLICENSED"
}
